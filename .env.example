# ────────────────────────────────────────────────────────────────
# Template only — copy to `.env` and fill in real values locally.
# NEVER put real values in this file — it's committed to git.
# Production values live in Vercel → Settings → Environment Variables.
# ────────────────────────────────────────────────────────────────

# Anthropic (Claude API) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Service role key: full admin access, server-side ONLY, never ships to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Domain email API (Resend / SendGrid / Postmark — pick one)
# Server-side ONLY. Calls go through /api/send-email.mjs.
EMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
